# ==================== 应用基础 ====================
APP_NAME=CoCoWork
APP_VERSION=0.1.0
DEBUG_MODE=true

# ==================== 服务器 ====================
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ==================== API ====================
API_PREFIX=/api/v1

# ==================== JWT ====================
# 生产环境务必替换；可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1800

# ==================== 内置管理员（seed 脚本用）====================
# ADMIN_PASSWORD 留空则 `python -m app.scripts.seed_admin` 跳过创建
ADMIN_USERNAME=admin
ADMIN_EMAIL=nuguri990717@gmail.com
ADMIN_PASSWORD=020121

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# ==================== PostgreSQL ====================
# 复用 DaisyWind 同一个远端 PG 容器，仅 PG_DATABASE 不同
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=cocowork
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# ==================== 存储后端 ====================
# r2 | local；生产用 r2，本地开发可切 local（不联网）
STORAGE_BACKEND=r2
STORAGE_LOCAL_ROOT=data/uploads

# ==================== 沙箱 ====================
# 工作区根目录：相对路径锚在 backend/ 下，也可填绝对路径（部署时指向挂载点）
SANDBOX_LOCAL_ROOT=data/sandbox
# 单个产物大小上限，默认 20MB
SANDBOX_ARTIFACT_MAX_SIZE=20971520

# ==================== 对象存储 (R2) ====================
# 跟 DaisyWind 同账号，桶名独立用 cocowork
R2_ENDPOINT=https://<AccountID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=cocowork

# ==================== Langfuse 可观测 ====================
# 留空则不挂 callback（本地裸跑 / CI 零报错）；key 在 Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ==================== 应用基础 ====================
APP_NAME=CoCoWork
APP_VERSION=0.1.0
DEBUG_MODE=true

# ==================== 服务器 ====================
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ==================== API ====================
API_PREFIX=/api/v1

# ==================== JWT ====================
# 生产环境务必替换；可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1800

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# ==================== PostgreSQL ====================
# 复用 DaisyWind 同一个远端 PG 容器，仅 PG_DATABASE 不同
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=cocowork
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

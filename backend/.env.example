# ==================== 应用基础 ====================
APP_NAME=CoCoWork
APP_VERSION=0.1.0
DEBUG_MODE=true

# ==================== 服务器 ====================
HOST=127.0.0.1
PORT=8000
RELOAD=true

# ==================== API ====================
API_PREFIX=/api/v1

# ==================== JWT ====================
# 生产环境务必替换；可用 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1800

# ==================== 敏感凭证加密（Fernet）====================
# Provider API Key / MCP server headers 落库前用它加密。**必填**，且必须是合法的
# Fernet key（32 字节 urlsafe base64）—— 格式不对时 app/core/encryption.py 在导入期
# 就抛错，应用根本起不来。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ⚠️ 换掉它 = 库里已加密的凭证全部解不开，只能一条条重填。
ENCRYPTION_KEY=

# ==================== 内置管理员（seed 脚本用）====================
# ADMIN_PASSWORD 留空则 `python -m app.scripts.seed_admin` 跳过创建
ADMIN_USERNAME=admin
ADMIN_EMAIL=nuguri990717@gmail.com
ADMIN_PASSWORD=020121

# ==================== Redis ====================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=123456
REDIS_DB=0
REDIS_MAX_CONNECTIONS=10

# ==================== PostgreSQL ====================
# 复用 DaisyWind 同一个远端 PG 容器，仅 PG_DATABASE 不同
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=cocowork
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10

# ==================== 存储后端 ====================
# r2 | local；生产用 r2，本地开发可切 local（不联网）
STORAGE_BACKEND=r2
STORAGE_LOCAL_ROOT=data/uploads

# ==================== 文档解析（云端路）====================
# 百度智能云「文档解析」（PaddleOCR-VL）的 AK/SK，控制台 → 应用列表里取。
# 留空则知识库建库时「百度」这个解析后端不可选，本地 pdfplumber 那条路不受影响。
BAIDU_DOCPARSE_API_KEY=
BAIDU_DOCPARSE_SECRET_KEY=

# ==================== 沙箱 ====================
# 执行后端：local = 直接在宿主机跑，不装 docker 也能跑通整条 skill 链路，面向
# clone 项目的开发者，**不提供任何隔离**；docker = 一次性容器，生产用这个。
SANDBOX_DRIVER=local
# 工作区根目录：相对路径锚在 backend/ 下，也可填绝对路径（部署时指向挂载点）。
# 只对 local driver 有意义 —— docker driver 的四个目录都在容器里。
SANDBOX_LOCAL_ROOT=data/sandbox
# 单个产物大小上限，默认 20MB
SANDBOX_ARTIFACT_MAX_SIZE=20971520

# ---------- 以下仅 SANDBOX_DRIVER=docker 时需要 ----------
# 沙箱镜像，先 build 出来：docker build -t cocowork-sandbox:0.1 docker/sandbox
SANDBOX_IMAGE=cocowork-sandbox:0.1
# web 与 sandboxd 之间的内部令牌，**必填**，留空则 sandboxd 拒绝启动。
# 自己生成一个：python -c "import secrets; print(secrets.token_urlsafe(32))"
SANDBOX_TOKEN=
# 指挥哪个 docker daemon：留空 = 本机 docker.sock；
# ssh://user@host = 远程 daemon（开发机不必装 Docker，读 ~/.ssh/config 的主机别名）
SANDBOX_DOCKER_HOST=
# 容器加固参数 —— 隔离就是这几条，不是「用了 docker」四个字
SANDBOX_NETWORK=cocowork-sandbox
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
# 容器最长存活秒数，超时由 sandboxd 的反收割强制清理（兜底，正常一轮回复就销毁）
SANDBOX_SESSION_TTL=900
# sandboxd 监听地址。**绝不可对外**：这个进程挂着 docker.sock，等于整台机器
SANDBOXD_HOST=127.0.0.1
SANDBOXD_PORT=8100

# ==================== 对象存储 (R2) ====================
# 跟 DaisyWind 同账号，桶名独立用 cocowork
R2_ENDPOINT=https://<AccountID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=cocowork

# ==================== Langfuse 可观测 ====================
# 留空则不挂 callback（本地裸跑 / CI 零报错）；key 在 Langfuse UI → Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_HOST=https://cloud.langfuse.com
